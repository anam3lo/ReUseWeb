# Copie este arquivo para .env e preencha com os seus dados.
# Nunca coloque senhas reais aqui: este arquivo vai para o GitHub.

# Endereço do banco PostgreSQL (Neon, por exemplo). Pegue em: painel do Neon > Connect
DATABASE_URL="postgresql://USUARIO:SENHA@SEU-HOST.neon.tech/neondb?sslmode=require"

NEXTAUTH_URL="http://localhost:3000"
# Gere um texto longo e aleatório para a chave abaixo
NEXTAUTH_SECRET="sua-chave-secreta-aqui"
NODE_ENV="development"
